# Netlify Ignore File
# Files and directories to exclude from Netlify builds and deployments

# Node modules
node_modules/

# Dependencies
package-lock.json
yarn.lock

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test and coverage
coverage/
.karma/
.nyc_output/

# Build artifacts (keep only dist)
build/
tmp/
temp/

# Angular
.angular/
angular.json.* 

# TypeScript
tsconfig.app.json.* 
tsconfig.spec.json.*

# Git
.git/
.gitignore

# Environment files with sensitive data (if any)
.env.local
.env.*.local

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
.tmp/
*.tmp
